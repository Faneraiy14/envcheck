{
    "name": "faneraiy14/envcheck",
    "description": "CLI-утиліта, що звіряє .env із .env.example: відсутні ключі, порожні обов'язкові значення, зайві ключі.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Faneraiy14"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "EnvCheck\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/envcheck"
    ],
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10"
    },
    "scripts": {
        "test": "phpunit"
    }
}
