#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../src/EnvChecker.php';

use EnvCheck\EnvChecker;

function colorize(string $text, string $color): string
{
    $codes = ['red' => '31', 'green' => '32', 'yellow' => '33', 'cyan' => '36', 'gray' => '90'];
    // Windows-термінали без ANSI (старий cmd.exe) просто покажуть коди
    // текстом — не критично для CLI-інструменту, тому не ускладнюємо
    // детекцією підтримки кольору.
    if (!isset($codes[$color])) {
        return $text;
    }
    return "\033[{$codes[$color]}m{$text}\033[0m";
}

function printUsage(): void
{
    echo "envcheck — звіряє .env із .env.example\n\n";
    echo "Використання:\n";
    echo "  envcheck [шлях-до-.env] [шлях-до-.env.example] [опції]\n\n";
    echo "За замовчуванням: .env і .env.example у поточній папці.\n\n";
    echo "Опції:\n";
    echo "  --fix     дописати відсутні ключі в .env як 'KEY=' (порожнє\n";
    echo "            значення — заповнити треба вручну; наявні рядки не чіпає)\n";
    echo "  --strict  провалити перевірку (exit 1) і за зайвих ключів теж,\n";
    echo "            не тільки за відсутніх/порожніх\n";
    echo "  --json    вивід як JSON замість тексту з кольорами — для CI\n";
    echo "            та інших скриптів, а не для читання людиною\n";
}

$flags = ['--fix', '--strict', '--json'];
$args = array_slice($argv, 1);

if (in_array('--help', $args, true) || in_array('-h', $args, true)) {
    printUsage();
    exit(0);
}

$fix = in_array('--fix', $args, true);
$strict = in_array('--strict', $args, true);
$json = in_array('--json', $args, true);
$positional = array_values(array_filter($args, static fn (string $a): bool => !in_array($a, $flags, true)));

$envPath = $positional[0] ?? '.env';
$examplePath = $positional[1] ?? '.env.example';

$checker = new EnvChecker();

try {
    $result = $checker->check($envPath, $examplePath);
} catch (\RuntimeException $e) {
    if ($json) {
        echo json_encode(['error' => $e->getMessage()], JSON_UNESCAPED_UNICODE) . "\n";
    } else {
        fwrite(STDERR, colorize('Помилка: ', 'red') . $e->getMessage() . "\n");
    }
    exit(2);
}

if ($fix && $result['missing'] !== []) {
    $checker->appendMissing($envPath, $result['missing']);
}

$hasProblems = $result['missing'] !== [] || $result['empty'] !== [] || ($strict && $result['extra'] !== []);

if ($json) {
    echo json_encode([
        'ok' => !$hasProblems,
        'envPath' => $envPath,
        'examplePath' => $examplePath,
        'missing' => $result['missing'],
        'empty' => $result['empty'],
        'extra' => $result['extra'],
        'fixed' => $fix && $result['missing'] !== [],
    ], JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT) . "\n";
    exit($hasProblems ? 1 : 0);
}

if ($result['missing'] === [] && $result['extra'] === [] && $result['empty'] === []) {
    echo colorize('✓ ', 'green') . "{$envPath} відповідає {$examplePath}\n";
    exit(0);
}

if ($result['missing'] !== []) {
    echo colorize('✗ Відсутні ключі', 'red') . " (є в {$examplePath}, немає в {$envPath}):\n";
    foreach ($result['missing'] as $key) {
        echo "    {$key}\n";
    }

    if ($fix) {
        echo colorize('  → дописано в ' . $envPath . ' як порожні (заповни значення вручну)', 'gray') . "\n";
    }
}

if ($result['empty'] !== []) {
    echo colorize('⚠ Порожні значення', 'yellow') . " (ключ є, значення не заповнене):\n";
    foreach ($result['empty'] as $key) {
        echo "    {$key}\n";
    }
}

if ($result['extra'] !== []) {
    $label = $strict ? '✗ Зайві ключі' : 'ℹ Зайві ключі';
    $note = $strict ? ' (--strict: це теж провалює перевірку)' : ' (не помилка, просто інфо)';
    echo colorize($label, $strict ? 'red' : 'cyan') . " (є в {$envPath}, немає в {$examplePath}){$note}:\n";
    foreach ($result['extra'] as $key) {
        echo "    {$key}\n";
    }
}

exit($hasProblems ? 1 : 0);
